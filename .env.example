# Copy to .env and fill in. Never commit .env.

# Which LLM provider the planner uses. "gemini" is the only real provider today.
LLM_PROVIDER=gemini

# https://aistudio.google.com/apikey — free tier, no card needed.
GEMINI_API_KEY=

# Primary planning model. gemini-2.5-flash-lite has a higher free-tier daily quota
# but is a weaker planner on multi-step questions.
GEMINI_MODEL=gemini-2.5-flash

# Used once, automatically, if the primary model returns a rate-limit (429).
# Set to an empty value to disable the fallback.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
