# Copy to .env and fill in. Never commit .env.

# Which LLM provider the planner uses. "gemini" is the only real provider today.
LLM_PROVIDER=gemini

# https://aistudio.google.com/apikey — free tier, no card needed.
GEMINI_API_KEY=

# Optional second key, tried automatically when the first is rate limited.
# The free tier is small; a second key doubles the ceiling but does not remove it.
GEMINI_API_KEY_2=

# Primary planning model. gemini-3.6-flash is the default because it is the one
# current flash model verified to accept this project's request config; several
# others return 503 (high demand), 400, or 404 for newer accounts.
GEMINI_MODEL=gemini-3.6-flash

# Tried when the primary model is rate limited (429) or busy (503). A 503 is
# the model being saturated for everyone, so a second key cannot escape it -
# only a different model can. Empty disables the fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# How hard the model may reason before producing a plan: MINIMAL, LOW, MEDIUM
# or HIGH. Building a plan is translation, not reasoning, so MINIMAL is right.
# Note this is the Gemini 3.x parameter; the 2.x `thinking_budget` is either
# ignored (the model then reasons at full depth, roughly tripling latency) or
# rejected outright. Some models accept only a subset of the levels.
GEMINI_THINKING_LEVEL=MINIMAL
